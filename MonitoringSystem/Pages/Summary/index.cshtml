@page
@using System.Globalization
@using MonitoringSystem.Pages.Summary
@model MonitoringSystem.Pages.Summary.SummaryModel
@{
    ViewData["Title"] = "Production Summary";

    string[] shiftHeaders = new[] {
        "Shift", "Assembly Line", "Daily Plan", "Plan", "Act", "Difference",
        "Loss Time (min)", "Work Time (min)", "Model Start Time", "Model End Time",
        "Opr. Ratio (%)", "Work Eff. (%)", "Pass Through Ratio (%)", "Total Eff. (%)",
        "P/H/H", "# of Model Change", "Model Chg Time (min)"
    };

    string[] overallHeaders = new[] {
        "Total Overall", "Daily Plan", "Plan", "Act", "Difference",
        "Loss Time (min)", "Work Time (min)",
        "Opr. Ratio (%)", "Work Eff. (%)", "Pass Through Ratio (%)", "Total Eff. (%)",
        "# of Model Change", "Model Chg Time (min)"
    };
}

<div>
    <div class="row d-flex justify-content-between mx-3 align-items-center">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <form method="post" class="summary-filter">
                    <div class="form-group d-flex align-items-center gap-3 flex-wrap">
                        <div class="d-flex gap-2 align-items-center">
                            <label class="fw-bold fs-6">Start Date</label>
                            <input type="date" class="form-control" name="StartSelectedDate"
                                   value="@Model.StartSelectedDate.ToString("yyyy-MM-dd")" style="width:160px">
                        </div>
                        <div class="d-flex gap-2 align-items-center">
                            <label class="fw-bold fs-6">End Date</label>
                            <input type="date" class="form-control" name="EndSelectedDate"
                                   value="@Model.EndSelectedDate.ToString("yyyy-MM-dd")" style="width:160px">
                        </div>
                        <button type="submit" class="btn fw-bold fs-6 btn-summary">Search</button>
                    </div>
                </form>
                <div>
                    <span class="badge bg-primary px-3 py-2 fs-7">Panamon Audio - 11 Assembly Lines</span>
                </div>
            </div>
        </div>
    </div>

    <hr />

    @if (Model.StartSelectedDate.Date != Model.EndSelectedDate.Date)
    {
        <p class="ms-3 fs-5 fw-bold summary-date-label">
            @Model.StartSelectedDate.ToString("dddd, dd MMMM yyyy") - @Model.EndSelectedDate.ToString("dddd, dd MMMM yyyy")
        </p>
    }
    else
    {
        <p class="ms-3 fs-5 fw-bold summary-date-label">
            @Model.StartSelectedDate.ToString("dddd, dd MMMM yyyy")
        </p>
    }

    <div class="w-100">
        @* Shift 1 Table *@
        <div class="mt-3 mx-3 table-responsive summary-card rounded-3 p-0 m-0" id="Shift1Table">
            <div class="p-2 px-3 fw-bold bg-dark text-white d-flex justify-content-between align-items-center">
                <span>Shift 1 (07:05 - 15:55)</span>
                <small class="opacity-75">Audio Assembly Lines</small>
            </div>
            <table class="table text-center align-middle overflow-hidden p-0 m-0">
                <thead>
                    <tr class="align-middle">
                        @foreach (var h in shiftHeaders)
                        {
                            <th class="fw-medium border-end">@h</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Shift1Summaries)
                    {
                        <tr>
                            <td class="border fs-6 fw-medium">1</td>
                            <td class="border fs-6 fw-bold">@item.LineName</td>
                            <td class="border fs-6 fw-medium">@item.DailyPlan</td>
                            <td class="border fs-6 fw-medium">@item.Plan</td>
                            <td class="border fs-6 fw-medium">@item.Actual</td>
                            <td class="border fs-6 fw-medium @(item.Difference < 0 ? "text-danger" : "")">@item.Difference</td>
                            <td class="border fs-6 fw-medium">@Math.Round(item.LossTimeMinutes)</td>
                            <td class="border fs-6 fw-medium">@Math.Round(item.WorkTimeMinutes)</td>
                            <td class="border fs-6 fw-medium">@(item.ModelStartTime?.ToString("HH:mm:ss") ?? "-")</td>
                            <td class="border fs-6 fw-medium">@(item.ModelEndTime?.ToString("HH:mm:ss") ?? "-")</td>
                            <td class="border fs-6 fw-medium">@item.OprRatio.ToString("F2") %</td>
                            <td class="border fs-6 fw-medium">@item.WorkEff.ToString("F2") %</td>
                            <td class="border fs-6 fw-medium">@item.DefectRatio.ToString("F2") %</td>
                            <td class="border fs-6 fw-medium">@item.TotalEff.ToString("F2") %</td>
                            <td class="border fs-6 fw-medium">@(item.Pph > 0 ? item.Pph.ToString("F2") : "-")</td>
                            <td class="border fs-6 fw-medium">@item.ModelChanges</td>
                            <td class="border fs-6 fw-medium">@Math.Round(item.ModelTimeChange, 2)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* Shift 2 Table *@
        <div class="mt-4 mx-3 table-responsive summary-card rounded-3 p-0 m-0" id="Shift2Table">
            <div class="p-2 px-3 fw-bold bg-dark text-white d-flex justify-content-between align-items-center">
                <span>Shift 2 (16:00 - 23:15)</span>
                <small class="opacity-75">Audio Assembly Lines</small>
            </div>
            <table class="table text-center align-middle overflow-hidden p-0 m-0">
                <thead>
                    <tr class="align-middle">
                        @foreach (var h in shiftHeaders)
                        {
                            <th class="fw-medium border-end">@h</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Shift2Summaries)
                    {
                        <tr>
                            <td class="border fs-6 fw-medium">2</td>
                            <td class="border fs-6 fw-bold">@item.LineName</td>
                            <td class="border fs-6 fw-medium">@item.DailyPlan</td>
                            <td class="border fs-6 fw-medium">@item.Plan</td>
                            <td class="border fs-6 fw-medium">@item.Actual</td>
                            <td class="border fs-6 fw-medium @(item.Difference < 0 ? "text-danger" : "")">@item.Difference</td>
                            <td class="border fs-6 fw-medium">@Math.Round(item.LossTimeMinutes)</td>
                            <td class="border fs-6 fw-medium">@Math.Round(item.WorkTimeMinutes)</td>
                            <td class="border fs-6 fw-medium">@(item.ModelStartTime?.ToString("HH:mm:ss") ?? "-")</td>
                            <td class="border fs-6 fw-medium">@(item.ModelEndTime?.ToString("HH:mm:ss") ?? "-")</td>
                            <td class="border fs-6 fw-medium">@item.OprRatio.ToString("F2") %</td>
                            <td class="border fs-6 fw-medium">@item.WorkEff.ToString("F2") %</td>
                            <td class="border fs-6 fw-medium">@item.DefectRatio.ToString("F2") %</td>
                            <td class="border fs-6 fw-medium">@item.TotalEff.ToString("F2") %</td>
                            <td class="border fs-6 fw-medium">@(item.Pph > 0 ? item.Pph.ToString("F2") : "-")</td>
                            <td class="border fs-6 fw-medium">@item.ModelChanges</td>
                            <td class="border fs-6 fw-medium">@Math.Round(item.ModelTimeChange, 2)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* Shift 3 Table *@
        <div class="mt-4 mx-3 table-responsive summary-card rounded-3 p-0 m-0" id="Shift3Table">
            <div class="p-2 px-3 fw-bold bg-dark text-white d-flex justify-content-between align-items-center">
                <span>Shift 3 (23:15 - 07:00)</span>
                <small class="opacity-75">Audio Assembly Lines</small>
            </div>
            <table class="table text-center align-middle overflow-hidden p-0 m-0">
                <thead>
                    <tr class="align-middle">
                        @foreach (var h in shiftHeaders)
                        {
                            <th class="fw-medium border-end">@h</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Shift3Summaries)
                    {
                        <tr>
                            <td class="border fs-6 fw-medium">3</td>
                            <td class="border fs-6 fw-bold">@item.LineName</td>
                            <td class="border fs-6 fw-medium">@item.DailyPlan</td>
                            <td class="border fs-6 fw-medium">@item.Plan</td>
                            <td class="border fs-6 fw-medium">@item.Actual</td>
                            <td class="border fs-6 fw-medium @(item.Difference < 0 ? "text-danger" : "")">@item.Difference</td>
                            <td class="border fs-6 fw-medium">@Math.Round(item.LossTimeMinutes)</td>
                            <td class="border fs-6 fw-medium">@Math.Round(item.WorkTimeMinutes)</td>
                            <td class="border fs-6 fw-medium">@(item.ModelStartTime?.ToString("HH:mm:ss") ?? "-")</td>
                            <td class="border fs-6 fw-medium">@(item.ModelEndTime?.ToString("HH:mm:ss") ?? "-")</td>
                            <td class="border fs-6 fw-medium">@item.OprRatio.ToString("F2") %</td>
                            <td class="border fs-6 fw-medium">@item.WorkEff.ToString("F2") %</td>
                            <td class="border fs-6 fw-medium">@item.DefectRatio.ToString("F2") %</td>
                            <td class="border fs-6 fw-medium">@item.TotalEff.ToString("F2") %</td>
                            <td class="border fs-6 fw-medium">@(item.Pph > 0 ? item.Pph.ToString("F2") : "-")</td>
                            <td class="border fs-6 fw-medium">@item.ModelChanges</td>
                            <td class="border fs-6 fw-medium">@Math.Round(item.ModelTimeChange, 2)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* Overall Table *@
        <div class="mt-4 mx-3 mb-4 table-responsive summary-card rounded-3 p-0 m-0" id="OverallTable">
            <div class="p-2 px-3 fw-bold bg-dark text-white d-flex justify-content-between align-items-center">
                <span>Total Overall Production (All Shifts)</span>
                <small class="opacity-75">Audio Assembly Lines</small>
            </div>
            <table class="table text-center align-middle overflow-hidden p-0 m-0">
                <thead>
                    <tr class="align-middle">
                        @foreach (var h in overallHeaders)
                        {
                            <th class="fw-medium border-end">@h</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.OverallSummaries)
                    {
                        <tr>
                            <th class="border fs-6 fw-bold" scope="row">Total @item.LineName</th>
                            <td class="border fs-6 fw-medium">@item.DailyPlan</td>
                            <td class="border fs-6 fw-medium">@item.Plan</td>
                            <td class="border fs-6 fw-medium">@item.Actual</td>
                            <td class="border fs-6 fw-medium @(item.Difference < 0 ? "text-danger" : "")">@item.Difference</td>
                            <td class="border fs-6 fw-medium">@Math.Round(item.LossTimeMinutes)</td>
                            <td class="border fs-6 fw-medium">@Math.Round(item.WorkTimeMinutes)</td>
                            <td class="border fs-6 fw-medium">@item.OprRatio.ToString("F2") %</td>
                            <td class="border fs-6 fw-medium">
                                @if (item.Plan == 0 && item.Actual > 0)
                                {
                                    <text>&infin; %</text>
                                }
                                else
                                {
                                    @item.WorkEff.ToString("F2") <text>%</text>
                                }
                            </td>
                            <td class="border fs-6 fw-medium">@item.DefectRatio.ToString("F2") %</td>
                            <td class="border fs-6 fw-medium">
                                @if (item.Plan == 0 && item.Actual > 0)
                                {
                                    <text>&infin; %</text>
                                }
                                else
                                {
                                    @item.TotalEff.ToString("F2") <text>%</text>
                                }
                            </td>
                            <td class="border fs-6 fw-medium">@item.ModelChanges</td>
                            <td class="border fs-6 fw-medium">@Math.Round(item.ModelTimeChange, 2)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
