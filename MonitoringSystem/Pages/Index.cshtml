@page
@model IndexModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Panamon - Pilih Monitoring</title>
    <link rel="icon" href="~/assets/PanasonicIcon.png" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" />
    <link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true" />
    <style>
        * { box-sizing: border-box; }

        html, body {
            margin: 0;
            min-height: 100vh;
            font-family: 'DINPro', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            color: #fff;
        }

        body {
            background: url('/assets/BackgroundPanamon.png') no-repeat center center fixed;
            background-size: cover;
        }

        /* Overlay gelap: halaman di belakang popup kosong */
        .chooser-backdrop {
            position: fixed;
            inset: 0;
            background: rgba(6, 10, 30, 0.72);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 16px;
        }

        .chooser-modal {
            width: 100%;
            max-width: 960px;
            background: rgba(30, 38, 72, 0.96);
            border: 1px solid rgba(255, 255, 255, 0.14);
            border-radius: 16px;
            box-shadow: 0 24px 60px rgba(0, 0, 0, 0.55);
            padding: 32px;
            text-align: center;
            animation: chooser-in .25s ease-out;
        }

        @@keyframes chooser-in {
            from { opacity: 0; transform: translateY(12px) scale(.98); }
            to { opacity: 1; transform: none; }
        }

        .chooser-logo {
            height: 28px;
            margin-bottom: 18px;
        }

        .chooser-title {
            margin: 0 0 6px;
            font-size: 1.4rem;
            font-weight: 700;
            letter-spacing: .5px;
        }

        .chooser-sub {
            margin: 0 0 28px;
            font-size: .9rem;
            color: rgba(255, 255, 255, 0.65);
        }

        .chooser-options {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }

        .chooser-card {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 14px;
            min-height: 200px;
            padding: 24px 16px;
            border-radius: 14px;
            background: rgba(255, 255, 255, 0.05);
            border: 2px solid rgba(255, 255, 255, 0.12);
            color: #fff;
            text-decoration: none;
            transition: transform .15s ease, border-color .15s ease, background .15s ease, box-shadow .15s ease;
        }

            .chooser-card i {
                font-size: 3rem;
            }

            /* ikon SVG RAC / CAC, sebesar ikon font MACHINE */
            .chooser-card .chooser-icon {
                width: 3rem;
                height: 3rem;
            }

            .chooser-card .chooser-name {
                font-size: 1.5rem;
                font-weight: 800;
                letter-spacing: 2px;
            }

            .chooser-card .chooser-desc {
                font-size: .8rem;
                color: rgba(255, 255, 255, 0.6);
            }

            .chooser-card:hover,
            .chooser-card:focus-visible {
                transform: translateY(-3px);
                outline: none;
            }

        .chooser-rac i, .chooser-rac .chooser-icon { color: #4fc3f7; }
        .chooser-rac:hover, .chooser-rac:focus-visible {
            border-color: #4fc3f7;
            background: rgba(79, 195, 247, 0.12);
            box-shadow: 0 10px 28px rgba(79, 195, 247, 0.25);
        }

        .chooser-machine i { color: #2ecc71; }
        .chooser-machine:hover, .chooser-machine:focus-visible {
            border-color: #2ecc71;
            background: rgba(46, 204, 113, 0.12);
            box-shadow: 0 10px 28px rgba(46, 204, 113, 0.25);
        }

        .chooser-cac i, .chooser-cac .chooser-icon { color: #f39c12; }
        .chooser-cac:hover, .chooser-cac:focus-visible {
            border-color: #f39c12;
            background: rgba(243, 156, 18, 0.12);
            box-shadow: 0 10px 28px rgba(243, 156, 18, 0.25);
        }

        @@media (max-width: 760px) {
            .chooser-modal { padding: 24px 16px; }
            .chooser-options { grid-template-columns: 1fr; }
            .chooser-card { min-height: 150px; }
        }
    </style>
</head>
<body>
    <div class="chooser-backdrop">
        <div class="chooser-modal" role="dialog" aria-modal="true" aria-labelledby="chooserTitle">
            <img class="chooser-logo" src="~/assets/PanasonicIcon.png" alt="Panasonic" />
            <h1 class="chooser-title" id="chooserTitle">Pilih Monitoring</h1>
            <p class="chooser-sub">Silakan pilih halaman yang ingin dibuka</p>

            <div class="chooser-options">
                <a class="chooser-card chooser-rac" href="/ProductionReport/index">
                    @* RAC: Tabler air-conditioning (MIT), SVG langsung tanpa library *@
                    <svg class="chooser-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 16a3 3 0 0 1 -3 3"/><path d="M16 16a3 3 0 0 0 3 3"/><path d="M12 16v4"/><path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v4a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2l0 -4"/><path d="M7 13v-3a1 1 0 0 1 1 -1h8a1 1 0 0 1 1 1v3"/></svg>
                    <span class="chooser-name">RAC</span>
                    <span class="chooser-desc">Production Monitoring RAC</span>
                </a>
                <a class="chooser-card chooser-cac" href="/CAC/ProductionReport/index">
                    @* CAC: Material Symbols air_purifier_gen (Apache 2.0) *@
                    <svg class="chooser-icon" viewBox="0 -960 960 960" fill="currentColor" aria-hidden="true"><path d="M120-120v-600q0-50 35-85t85-35h160q50 0 85 35t35 85v600H120Zm280-240h40v-200h-40v200ZM200-200h240v-80h-40q-33 0-56.5-23.5T320-360v-200q0-33 23.5-56.5T400-640h40v-80q0-17-11.5-28.5T400-760H240q-17 0-28.5 11.5T200-720v520Zm488-217q-26 0-51-7t-49-18l25-76q20 9 39.5 15t36.5 6q12 0 24-4t25-12q24-17 48-23t46-6q25 0 51.5 6.5T933-518l-25 76q-23-8-42.5-14t-33.5-6q-12 0-26.5 4.5T775-442q-21 14-42.5 19.5T688-417Zm1-156q-26 0-52-7t-49-18l25-76q26 11 44 16t32 5q12 0 24-3.5t25-12.5q25-17 48.5-23t45.5-6q25 0 50 6.5t51 17.5l-25 76q-26-9-44-14.5t-32-5.5q-13 0-26.5 4T775-598q-18 13-40.5 19t-45.5 6Zm0 312q-26 0-51.5-7T588-286l25-76q22 10 41 15.5t35 5.5q12 0 24-3.5t25-12.5q23-16 49-22.5t46-6.5q25 0 51 7t49 17l-25 76q-26-9-44.5-14.5T832-306q-14 0-28.5 4.5T775-286q-17 12-39.5 18.5T689-261Zm-249 61v-528.5 8.5-8.5V-200Z"/></svg>
                    <span class="chooser-name">CAC</span>
                    <span class="chooser-desc">Production Monitoring CAC</span>
                </a>
                <a class="chooser-card chooser-machine" href="/ACOEE/dashboard">
                    <i class="fa-solid fa-gears"></i>
                    <span class="chooser-name">MACHINE</span>
                    <span class="chooser-desc">Production Monitoring Machine</span>
                </a>
            </div>
        </div>
    </div>
</body>
</html>
