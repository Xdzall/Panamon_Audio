@*
    Tombol "Move" di sidebar untuk navigasi cepat antar modul Panamon Audio.
*@
@{
    var movePath = (Context.Request.Path.Value ?? string.Empty).ToLowerInvariant();
    var config = Context.RequestServices.GetService<Microsoft.Extensions.Configuration.IConfiguration>();
    var dashboardUrl = config?["DashboardAudio:Url"] ?? "http://localhost:5108";

    var baseTargets = new[]
    {
        new { Key = "DASHBOARD", Href = dashboardUrl, Icon = "fa-gauge-high", Desc = "Audio Executive Dashboard", Bg = "rgba(14, 165, 233, 0.15)", Color = "#0ea5e9" },
        new { Key = "FINAL ASSY", Href = "/ProductionReport/index", Icon = "fa-headphones", Desc = "Audio Final Assembly Lines", Bg = "rgba(56, 189, 248, 0.15)", Color = "#38bdf8" },
        new { Key = "PERFORMANCE", Href = "/Perfomance/index", Icon = "fa-chart-line", Desc = "Line Efficiency & Cycle Time", Bg = "rgba(129, 140, 248, 0.15)", Color = "#818cf8" },
        new { Key = "LOSS TIME", Href = "/LossTime/index", Icon = "fa-clock", Desc = "Downtime & Line Stops", Bg = "rgba(248, 113, 113, 0.15)", Color = "#f87171" },
        new { Key = "INVENTORY", Href = "/Inventory/Index", Icon = "fa-boxes-stacked", Desc = "WIP & Stock Reconciliation", Bg = "rgba(251, 191, 36, 0.15)", Color = "#fbbf24" },
        new { Key = "SUMMARY", Href = "/Summary/index", Icon = "fa-table-cells-large", Desc = "Executive Summary, SUT & Plan", Bg = "rgba(52, 211, 153, 0.15)", Color = "#34d399" },
        new { Key = "QUALITY", Href = "/Quality/index", Icon = "fa-clipboard-check", Desc = "Defect Classification & Pareto", Bg = "rgba(232, 121, 249, 0.15)", Color = "#e879f9" },
    };

    var moveTargets = baseTargets.ToList();
    if (User?.IsInRole("Administrator") == true || User?.IsInRole("Admin") == true)
    {
        moveTargets.Add(new { Key = "USER MGMT", Href = "/Identity/Account/Register", Icon = "fa-users-gear", Desc = "Kelola Akun & Hak Akses", Bg = "rgba(168, 85, 247, 0.15)", Color = "#a855f7" });
    }
}

<li class="nav-item" id="moveNavItem" style="position: relative;">
    <a href="#" id="moveMenuBtn" title="Navigasi Audio">
        <i class="fa-solid fa-right-left"></i>
        <span class="nav-label">Move</span>
    </a>
    <div id="moveMenuPopup" class="sidebar-move-popup" role="menu" aria-label="Audio Module Navigation">
        <div class="move-popup-header">
            <div class="move-header-title">
                <i class="fa-solid fa-compass me-1"></i> Panamon Audio
            </div>
            <div class="move-header-subtitle">Navigasi Modul & Analisis</div>
        </div>

        <div class="move-popup-list">
            @foreach (var t in moveTargets)
            {
                bool isCurrent = movePath.StartsWith(t.Href.ToLowerInvariant());
                <a class="move-card @(isCurrent ? "active" : "")" href="@t.Href" role="menuitem">
                    <div class="move-card-icon" style="background: @t.Bg; color: @t.Color;">
                        <i class="fa-solid @t.Icon"></i>
                    </div>
                    <div class="move-card-info">
                        <div class="move-card-title-row">
                            <span class="move-card-title">@t.Key</span>
                            @if (isCurrent)
                            {
                                <span class="move-badge-active">Active</span>
                            }
                        </div>
                        <span class="move-card-desc">@t.Desc</span>
                    </div>
                    <div class="move-card-arrow">
                        <i class="fa-solid fa-chevron-right"></i>
                    </div>
                </a>
            }
        </div>
    </div>
</li>

<style>
/* ============================================================
   SIDEBAR MOVE POPUP - PANAMON AUDIO
   ============================================================ */
#bdSidebar .sidebar-move-popup {
    display: none;
    position: absolute;
    left: 100%;
    bottom: 0;
    margin-left: 10px;
    width: 285px;
    background: #172036 !important;
    border: 1px solid rgba(255, 255, 255, 0.20) !important;
    border-radius: 12px !important;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.65), 0 0 0 1px rgba(255, 255, 255, 0.06) !important;
    padding: 10px !important;
    z-index: 99999 !important;
    flex-direction: column !important;
    gap: 0 !important;
    box-sizing: border-box !important;
}

#bdSidebar .sidebar-move-popup.show {
    display: flex !important;
}

/* Header */
#bdSidebar .sidebar-move-popup .move-popup-header {
    padding: 2px 6px 8px 6px !important;
    border-bottom: 1px solid rgba(255, 255, 255, 0.10) !important;
    margin-bottom: 8px !important;
}

#bdSidebar .sidebar-move-popup .move-header-title {
    font-size: 11.5px !important;
    font-weight: 700 !important;
    color: #ffffff !important;
    letter-spacing: 0.5px !important;
    text-transform: uppercase !important;
    display: flex !important;
    align-items: center !important;
    gap: 6px !important;
}

#bdSidebar .sidebar-move-popup .move-header-title i {
    color: #38bdf8 !important;
    font-size: 12px !important;
}

#bdSidebar .sidebar-move-popup .move-header-subtitle {
    font-size: 10px !important;
    color: #94a3b8 !important;
    margin-top: 1px !important;
}

/* List Container */
#bdSidebar .sidebar-move-popup .move-popup-list {
    display: flex !important;
    flex-direction: column !important;
    gap: 6px !important;
    width: 100% !important;
    box-sizing: border-box !important;
}

/* Move Card Anchor - Override #bdSidebar .nav-item a Completely */
#bdSidebar .nav-item .sidebar-move-popup a.move-card,
#bdSidebar .sidebar-move-popup a.move-card,
#bdSidebar a.move-card {
    width: 100% !important;
    min-width: 0 !important;
    max-width: 100% !important;
    height: auto !important;
    min-height: 48px !important;
    max-height: none !important;
    display: flex !important;
    flex-direction: row !important;
    align-items: center !important;
    justify-content: flex-start !important;
    padding: 7px 10px !important;
    border-radius: 8px !important;
    text-decoration: none !important;
    background: rgba(255, 255, 255, 0.04) !important;
    border: 1px solid rgba(255, 255, 255, 0.08) !important;
    color: #ffffff !important;
    opacity: 1 !important;
    box-sizing: border-box !important;
    gap: 10px !important;
    transition: all 0.16s ease !important;
    line-height: normal !important;
}

#bdSidebar .nav-item .sidebar-move-popup a.move-card:hover,
#bdSidebar .sidebar-move-popup a.move-card:hover {
    background: rgba(255, 255, 255, 0.10) !important;
    border-color: rgba(56, 189, 248, 0.45) !important;
    transform: translateX(3px) !important;
}

#bdSidebar .nav-item .sidebar-move-popup a.move-card.active,
#bdSidebar .sidebar-move-popup a.move-card.active {
    background: rgba(56, 189, 248, 0.14) !important;
    border-color: rgba(56, 189, 248, 0.50) !important;
}

#bdSidebar .nav-item .sidebar-move-popup a.move-card.active::before {
    display: none !important;
}

/* Icon Box */
#bdSidebar .sidebar-move-popup .move-card-icon {
    width: 34px !important;
    height: 34px !important;
    min-width: 34px !important;
    max-width: 34px !important;
    border-radius: 8px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    flex-shrink: 0 !important;
    box-sizing: border-box !important;
}

#bdSidebar .sidebar-move-popup .move-card-icon i {
    font-size: 15px !important;
    width: auto !important;
    height: auto !important;
    line-height: 1 !important;
    margin: 0 !important;
    padding: 0 !important;
    display: inline-block !important;
}

/* Info Box */
#bdSidebar .sidebar-move-popup .move-card-info {
    flex: 1 1 auto !important;
    min-width: 0 !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: flex-start !important;
    justify-content: center !important;
    text-align: left !important;
    overflow: hidden !important;
}

#bdSidebar .sidebar-move-popup .move-card-title-row {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    width: 100% !important;
    gap: 6px !important;
}

#bdSidebar .sidebar-move-popup .move-card-title {
    font-size: 11.5px !important;
    font-weight: 700 !important;
    color: #f1f5f9 !important;
    letter-spacing: 0.3px !important;
    line-height: 1.2 !important;
    white-space: nowrap !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
}

#bdSidebar .sidebar-move-popup a.move-card.active .move-card-title {
    color: #38bdf8 !important;
}

#bdSidebar .sidebar-move-popup .move-badge-active {
    font-size: 8.5px !important;
    font-weight: 700 !important;
    padding: 1px 6px !important;
    border-radius: 999px !important;
    background: rgba(56, 189, 248, 0.25) !important;
    color: #38bdf8 !important;
    line-height: 1.2 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.5px !important;
    flex-shrink: 0 !important;
}

#bdSidebar .sidebar-move-popup .move-card-desc {
    font-size: 9.5px !important;
    color: #94a3b8 !important;
    line-height: 1.2 !important;
    margin-top: 2px !important;
    white-space: nowrap !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
    width: 100% !important;
    display: block !important;
}

/* Arrow */
#bdSidebar .sidebar-move-popup .move-card-arrow {
    color: rgba(255, 255, 255, 0.25) !important;
    font-size: 11px !important;
    margin-left: 2px !important;
    transition: transform 0.16s ease, color 0.16s ease !important;
    flex-shrink: 0 !important;
}

#bdSidebar .sidebar-move-popup a.move-card:hover .move-card-arrow {
    color: #38bdf8 !important;
    transform: translateX(2px) !important;
}

/* ============================================================
   LIGHT MODE OVERRIDES
   ============================================================ */
body.light-mode #bdSidebar .sidebar-move-popup {
    background: #ffffff !important;
    border-color: rgba(0, 0, 0, 0.12) !important;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.14), 0 0 0 1px rgba(0, 0, 0, 0.06) !important;
}

body.light-mode #bdSidebar .sidebar-move-popup .move-popup-header {
    border-bottom-color: rgba(0, 0, 0, 0.08) !important;
}

body.light-mode #bdSidebar .sidebar-move-popup .move-header-title {
    color: #0f172a !important;
}

body.light-mode #bdSidebar .sidebar-move-popup .move-header-subtitle {
    color: #64748b !important;
}

body.light-mode #bdSidebar .nav-item .sidebar-move-popup a.move-card,
body.light-mode #bdSidebar .sidebar-move-popup a.move-card {
    background: #f8fafc !important;
    border-color: #e2e8f0 !important;
}

body.light-mode #bdSidebar .nav-item .sidebar-move-popup a.move-card:hover,
body.light-mode #bdSidebar .sidebar-move-popup a.move-card:hover {
    background: #f1f5f9 !important;
    border-color: #0284c7 !important;
}

body.light-mode #bdSidebar .nav-item .sidebar-move-popup a.move-card.active,
body.light-mode #bdSidebar .sidebar-move-popup a.move-card.active {
    background: rgba(2, 132, 199, 0.08) !important;
    border-color: #0284c7 !important;
}

body.light-mode #bdSidebar .sidebar-move-popup .move-card-title {
    color: #0f172a !important;
}

body.light-mode #bdSidebar .sidebar-move-popup a.move-card.active .move-card-title {
    color: #0284c7 !important;
}

body.light-mode #bdSidebar .sidebar-move-popup .move-card-desc {
    color: #64748b !important;
}

body.light-mode #bdSidebar .sidebar-move-popup .move-card-arrow {
    color: #94a3b8 !important;
}
</style>

<script>
(function () {
    var btn = document.getElementById('moveMenuBtn');
    var popup = document.getElementById('moveMenuPopup');
    if (!btn || !popup) return;

    function closePopup() {
        popup.classList.remove('show');
        popup.style.bottom = '';
        popup.style.top = '';
    }

    btn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();

        // Tutup More Menu jika sedang terbuka
        var morePopup = document.getElementById('moreMenuPopup');
        if (morePopup) morePopup.style.display = 'none';

        var isOpen = popup.classList.contains('show');
        if (isOpen) {
            closePopup();
            return;
        }

        popup.classList.add('show');

        // Kalkulasi posisi vertikal agar tidak keluar layar (clamping cerdas)
        var btnRect = btn.getBoundingClientRect();
        var popupHeight = popup.offsetHeight || 370;
        var windowHeight = window.innerHeight;

        // Default: sejajar bawah dengan tombol Move
        popup.style.bottom = '0px';
        popup.style.top = 'auto';

        var popupRect = popup.getBoundingClientRect();
        if (popupRect.top < 12) {
            // Jika melebihi bagian atas layar, dorong ke bawah dengan jarak aman 12px
            var diff = 12 - popupRect.top;
            popup.style.bottom = (-diff) + 'px';
        } else if (popupRect.bottom > windowHeight - 12) {
            // Jika melebihi bagian bawah layar, angkat ke atas
            var diffBottom = popupRect.bottom - (windowHeight - 12);
            popup.style.bottom = diffBottom + 'px';
        }
    });

    // Tutup popup jika klik di luar
    document.addEventListener('click', function (e) {
        if (!popup.contains(e.target) && e.target !== btn && !btn.contains(e.target)) {
            closePopup();
        }
    });

    // Tutup jika tekan tombol Escape
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') closePopup();
    });

    // Tutup jika tombol More diklik
    var moreBtn = document.getElementById('moreMenuBtn');
    if (moreBtn) {
        moreBtn.addEventListener('click', function () {
            closePopup();
        });
    }
})();
</script>
