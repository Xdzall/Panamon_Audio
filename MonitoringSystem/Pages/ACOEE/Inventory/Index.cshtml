@page
@model MonitoringSystem.Pages.ACOEE.Inventory.indexModel
@{
    ViewData["Title"] = "Inventory";

    int daysInMonth = DateTime.DaysInMonth(Model.ActiveYear, Model.ActiveBulan);

    string[] namaBulan = new[]
    {
        "Januari", "Februari", "Maret", "April", "Mei", "Juni",
        "Juli", "Agustus", "September", "Oktober", "November", "Desember"
    };
}

<link rel="stylesheet" href="~/css/inventory.css" asp-append-version="true" />

<div class="inventory-dashboard">
<div class="filter-area-with-lines">
    <div class="panamon-bottom-line"></div>
    <div class="panamon-bottomm-line"></div>
    <div class="filter-content">
        <div class="row g-3 align-items-center justify-content-between flex-wrap">
            <div class="col-auto">
                <form id="invPaFilter" class="d-flex flex-wrap align-items-center gap-3">
                    <div class="d-flex align-items-center gap-2">
                        <label class="mb-0" for="invPaFrom">Dari</label>
                        <input type="date" id="invPaFrom" required />
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <label class="mb-0" for="invPaTo">Sampai</label>
                        <input type="date" id="invPaTo" required />
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <label class="mb-0">Machine</label>
                        <select class="form-select" style="width: 200px;" name="FilterMachineLine">
                            <option value="Expander" selected>Expander Kyoshin 635</option>
                        </select>
                    </div>
                    <button type="submit" class="inv-pa-btn">Terapkan</button>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="inv-card inv-card-split">
  <div class="inv-split">
   @* Kanan: Actual (kiri) vs Plan (kanan) per model Expander Kyoshin 6.35, default satu bulan (bulan tabel) *@
   <aside class="inv-runs" aria-label="Actual vs Plan per model Expander Kyoshin 6.35">
       <div class="inv-runs-head">
           <div class="inv-runs-title">
               <span class="inv-runs-machine">Expander Kyoshin 6.35 Actual vs Plan (Assembly)</span>
           </div>
       </div>
       <div class="inv-pa-legend">
           <span><i class="inv-pa-sw inv-pa-sw-actual"></i>Actual</span>
           <span><i class="inv-pa-sw inv-pa-sw-plan"></i>Plan</span>
       </div>
       <div class="inv-runs-body" id="invPaBody"></div>
   </aside>
  </div>
</div>
</div>

<script>
    window.__invMonth = { year: @Model.ActiveYear, month: @Model.ActiveBulan, days: @daysInMonth };
    window.__invStatusMessage = '@TempData["StatusMessage"]';
    window.__invMessage = '@TempData["Message"]';
</script>
<script src="~/js/inventory-runs.js" asp-append-version="true"></script>
