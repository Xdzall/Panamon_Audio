        function drawSolidArc(ctx, centerX, centerY, radius, percentage, color, lineWidth) {



    const startAngle = Math.PI * 0.75;



    const endAngle = Math.PI * 2.25;



    const totalAngle = endAngle - startAngle;



    // Track background



    ctx.beginPath();



    ctx.arc(centerX, centerY, radius, startAngle, endAngle, false);



    ctx.strokeStyle = 'rgba(150, 150, 150, 0.3)';



    ctx.lineWidth = lineWidth;



    ctx.lineCap = 'butt';



    ctx.stroke();



    // Progress



    if (percentage > 0) {



        const progressAngle = startAngle + (totalAngle * Math.min(percentage, 100) / 100);



        ctx.beginPath();



        ctx.lineCap = 'round';  // ← HARUS sebelum arc dan stroke



        ctx.arc(centerX, centerY, radius, startAngle, progressAngle, false);



        ctx.strokeStyle = color;



        ctx.lineWidth = lineWidth;



        ctx.stroke();



    }



}



        function getSpeedColor(percentage) {



            if (percentage >= 85) return '#28a745';



            else if (percentage >= 80) return '#ffc107';



            else return '#d90429';



        }



        function createOrUpdateChart(canvasId, chartInstance, actual, displayPlan, maxPlan) {



            const ref     = maxPlan > 0 ? maxPlan : displayPlan;



            const pct     = displayPlan > 0 ? (actual / displayPlan) * 100 : 0;



            const cNeedle = Math.min(pct, 120);



            const cActual = ref > 0 ? Math.min((actual / ref) * 100, 120) : 0;



            const cPlan   = ref > 0 ? Math.min((displayPlan / ref) * 100, 120) : 0;



            if (chartInstance) chartInstance.destroy();



            const canvas  = document.getElementById(canvasId);



            const wrapper = canvas.closest('.chart-container');



            const w = wrapper ? wrapper.offsetWidth  : 260;



            const h = wrapper ? wrapper.offsetHeight : 200;



            canvas.width = w; canvas.height = h;



            const ctx = canvas.getContext('2d');



            const safe = Math.min(w, h) * 0.94;



            const rO = safe * 0.42, rM = safe * 0.33, rI = safe * 0.24;



            const lw = safe * 0.046, sc = safe / 190;



            const cx = w * 0.50, cy = h * 0.55;



            ctx.clearRect(0, 0, w, h);



            // Backlight



            let bc, bi;



            if (pct < 80)      { bc = 'rgba(217,4,41,';  bi = 0.5; }



            else if (pct < 85) { bc = 'rgba(255,193,7,'; bi = 0.4; }



            else               { bc = 'rgba(40,167,69,';  bi = 0.35; }



            const blR = Math.max(rO * 0.28, 4);



            const sa = Math.PI * 0.75, ea = Math.PI * 2.25;



            const rStart = Math.max(0, blR - 12 * (typeof sc !== 'undefined' ? sc : 1));
            const rEnd = blR + 12 * (typeof sc !== 'undefined' ? sc : 1);
            const gl = ctx.createRadialGradient(cx, cy, rStart, cx, cy, rEnd);



            gl.addColorStop(0, bc+'0)'); gl.addColorStop(0.5, bc+bi+')'); gl.addColorStop(1, bc+'0)');



            ctx.beginPath(); ctx.arc(cx, cy, blR, sa, ea, false);



            ctx.strokeStyle = gl; ctx.lineWidth = 22 * sc; ctx.stroke();



            // Arcs: kuning=skala penuh, hijau=plan, ungu=actual



            drawSolidArc(ctx, cx, cy, rO, 100,    '#F59E0B', lw * 1.5);



            drawSolidArc(ctx, cx, cy, rM, cPlan,  '#22C55E', lw * 1.5);



            drawSolidArc(ctx, cx, cy, rI, cActual,'#A855F7', lw * 1.5);



            // Tick marks



            for (let i = 0; i < 11; i++) {



                const a = sa + (ea - sa) * (i / 10), maj = i % 2 === 0;



                const rIn = rO - 43*sc, rOut = rO - (maj ? 39 : 41)*sc;



                ctx.beginPath();



                ctx.moveTo(cx + rIn*Math.cos(a), cy + rIn*Math.sin(a));



                ctx.lineTo(cx + rOut*Math.cos(a), cy + rOut*Math.sin(a));



                ctx.strokeStyle = document.body.classList.contains('light-mode') ? '#1a1a2e' : '#fff';



                ctx.lineWidth = maj ? 2*sc : 1.5*sc; ctx.stroke();



            }



            // Numbers



            const isLM = document.body.classList.contains('light-mode');



            ctx.textAlign = 'center'; ctx.textBaseline = 'middle';



            [0, 20, 40, 60, 80, 100, 120].forEach(n => {



                const a = sa + (ea - sa) * (n / 120), tr = rO - 52*sc;



                const x = cx + tr*Math.cos(a), y = cy + tr*Math.sin(a);



                const gn = ctx.createRadialGradient(x, y, 0, x, y, 15*sc);



                gn.addColorStop(0,'rgba(100,150,255,0.4)'); gn.addColorStop(0.5,'rgba(100,150,255,0.2)'); gn.addColorStop(1,'rgba(100,150,255,0)');



                ctx.fillStyle = gn; ctx.fillRect(x-15*sc, y-15*sc, 30*sc, 30*sc);



                ctx.fillStyle = isLM ? 'rgba(20,20,40,0.9)' : 'rgba(255,255,255,0.9)';



                ctx.font = `bold ${Math.max(8, Math.round(9*sc))}px Arial`;



                ctx.fillText(n, x, y);



            });



            // Needle



            const nl = rO * 0.52, na = sa + (ea - sa) * (Math.min(cNeedle,120) / 120);



            const nx = cx + nl*Math.cos(na), ny = cy + nl*Math.sin(na);



            ctx.beginPath(); ctx.moveTo(cx+2,cy+2); ctx.lineTo(nx+2,ny+2);



            ctx.strokeStyle='rgba(0,0,0,0.4)'; ctx.lineWidth=6*sc; ctx.stroke();



            ctx.beginPath(); ctx.moveTo(cx,cy); ctx.lineTo(nx,ny);



            ctx.strokeStyle = isLM ? 'rgba(20,20,40,0.9)' : 'rgba(255,255,255,0.95)';



            ctx.lineWidth=3*sc; ctx.lineCap='round'; ctx.stroke();



            // Center dot



            ctx.beginPath(); ctx.arc(cx,cy,10*sc,0,2*Math.PI);



            ctx.fillStyle='#fff'; ctx.fill();



            ctx.strokeStyle='#363B5E'; ctx.lineWidth=3*sc; ctx.stroke();



            ctx.beginPath(); ctx.arc(cx,cy,4*sc,0,2*Math.PI);



            ctx.fillStyle='#363B5E'; ctx.fill();



            // Update HTML legend



            document.getElementById('legend-actual-total').textContent = actual.toLocaleString('id-ID');



            document.getElementById('legend-plan-total').textContent   = displayPlan.toLocaleString('id-ID');



            const achPct = displayPlan > 0 ? ((actual / displayPlan) * 100).toFixed(0) : 0;



            document.getElementById('legend-achievement-total').textContent = achPct;



            const sd = document.getElementById('speed-dot-total');



            if (sd) {



                const c = parseFloat(achPct) >= 85 ? '#22C55E' : parseFloat(achPct) >= 80 ? '#F59E0B' : '#d90429';



                sd.style.borderColor = c;



            }



            document.getElementById('total-plan-display-total').textContent = maxPlan.toLocaleString('id-ID');



            document.getElementById('chart-end-text-total').textContent = '';



            // Badge "Final" di canvas



            const bLabel='Final', bFS=Math.max(11,Math.round(sc*16));



            const bW=bFS*3.5, bH=bFS*1.6, bX=cx-bW/2, bY=cy+rO*0.60;



            ctx.save();



            ctx.beginPath();



            const br=5;



            ctx.moveTo(bX+br,bY); ctx.lineTo(bX+bW-br,bY);



            ctx.quadraticCurveTo(bX+bW,bY,bX+bW,bY+br); ctx.lineTo(bX+bW,bY+bH-br);



            ctx.quadraticCurveTo(bX+bW,bY+bH,bX+bW-br,bY+bH); ctx.lineTo(bX+br,bY+bH);



            ctx.quadraticCurveTo(bX,bY+bH,bX,bY+bH-br); ctx.lineTo(bX,bY+br);



            ctx.quadraticCurveTo(bX,bY,bX+br,bY); ctx.closePath();



            ctx.fillStyle='rgba(255,255,255,0.15)'; ctx.fill();



            ctx.strokeStyle=isLM?'rgba(10,10,30,0.7)':'rgba(255,255,255,0.5)';



            ctx.lineWidth=1.5; ctx.stroke();



            ctx.fillStyle=isLM?'#0a0a1e':'#ffffff';



            ctx.font=`bold ${bFS}px "DIN Pro",Verdana,sans-serif`;



            ctx.textAlign='center'; ctx.textBaseline='middle';



            ctx.fillText(bLabel,cx,bY+bH/2);



            ctx.restore();



            return null;



        }



        function drawTickMarks(ctx, centerX, centerY, radius, scale = 1) {



            const startAngle = Math.PI * 0.75;



            const endAngle = Math.PI * 2.25;



            const totalTicks = 11;



            for (let i = 0; i < totalTicks; i++) {



                const angle = startAngle + (endAngle - startAngle) * (i / (totalTicks - 1));



                const isMainTick = i % 2 === 0;



                const innerRadius = radius - (43 * scale);



                const outerRadius = radius - (isMainTick ? 39 * scale : 41 * scale);



                const x1 = centerX + innerRadius * Math.cos(angle);



                const y1 = centerY + innerRadius * Math.sin(angle);



                const x2 = centerX + outerRadius * Math.cos(angle);



                const y2 = centerY + outerRadius * Math.sin(angle);



                ctx.beginPath();



                ctx.moveTo(x1, y1);



                ctx.lineTo(x2, y2);



                ctx.strokeStyle = document.body.classList.contains('light-mode') ? '#1a1a2e' : '#fff';



                ctx.lineWidth = isMainTick ? 2 : 1.5;



                ctx.stroke();



            }



        }



        function drawNumbers(ctx, centerX, centerY, radius, scale = 1) {



            const startAngle = Math.PI * 0.75;



            const endAngle = Math.PI * 2.25;



            const numbers = [0, 20, 40, 60, 80, 100, 120];



            ctx.textAlign = 'center';



            ctx.textBaseline = 'middle';



            for (let i = 0; i < numbers.length; i++) {



                const angle = startAngle + (endAngle - startAngle) * (numbers[i] / 120);



                const textRadius = radius - (52 * scale);



                let x = centerX + textRadius * Math.cos(angle);



                let y = centerY + textRadius * Math.sin(angle);



                const glowGradient = ctx.createRadialGradient(x, y, 0, x, y, 15);



                glowGradient.addColorStop(0, 'rgba(100, 150, 255, 0.4)');



                glowGradient.addColorStop(0.5, 'rgba(100, 150, 255, 0.2)');



                glowGradient.addColorStop(1, 'rgba(100, 150, 255, 0)');



                ctx.fillStyle = glowGradient;



                ctx.fillRect(x - 15, y - 15, 30, 30);



                    ctx.fillStyle = document.body.classList.contains('light-mode')



        ? 'rgba(20, 20, 40, 0.9)'



        : 'rgba(255, 255, 255, 0.9)';



                ctx.font = `bold ${9 * scale}px Arial`;



                ctx.fillText(numbers[i], x, y);



            }



        }



        function drawNeedle(ctx, centerX, centerY, length, percentage, scale = 1) {



            const startAngle = Math.PI * 0.75;



            const endAngle = Math.PI * 2.25;



            const cappedPercentage = Math.min(percentage, 120);



            const angle = startAngle + (endAngle - startAngle) * (cappedPercentage / 120);



            const needleX = centerX + length * Math.cos(angle);



            const needleY = centerY + length * Math.sin(angle);



            // Shadow



            ctx.beginPath();



            ctx.moveTo(centerX + 2, centerY + 2);



            ctx.lineTo(needleX + 2, needleY + 2);



            ctx.strokeStyle = 'rgba(0, 0, 0, 0.4)';



            ctx.lineWidth = 6;



            ctx.stroke();



            // Needle putih



            ctx.beginPath();



            ctx.moveTo(centerX, centerY);



            ctx.lineTo(needleX, needleY);



                    const isLight = document.body.classList.contains('light-mode');



        ctx.strokeStyle = isLight ? 'rgba(20, 20, 40, 0.9)' : 'rgba(255, 255, 255, 0.95)';



            ctx.lineWidth = 3;



            ctx.lineCap = 'round';



            ctx.stroke();



        }



                function renderDefectBar(containerId, defectsByCategory) {



            const container = document.getElementById(containerId);



            if (!container) return;



            const sorted = [...defectsByCategory].sort((a, b) => b.count - a.count);



            const total = sorted.reduce((sum, d) => sum + d.count, 0);



            const maxVal = Math.max(...sorted.map(d => d.count), 1);



            container.innerHTML = '';



            sorted.forEach(d => {



                const barPct = (d.count / maxVal) * 100; // lebar bar relatif ke terbesar



                const labelPct = total > 0 ? (d.count / total) * 100 : 0; // persen tampil



                const row = document.createElement('div');



                row.className = 'defect-bar-row';



                row.innerHTML = `



                    <div class="defect-bar-label">${d.category}</div>



                    <div class="defect-bar-track">



                        <div class="defect-bar-fill" style="width:${barPct}%"></div>



                    </div>



                    <span class="defect-bar-value">${labelPct.toFixed(0)}%</span>



                `;



                container.appendChild(row);



            });



        }



        function setDate() {



            const dateElement = document.getElementById('current-date');



            const now = new Date();



            const weekdays = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];



            const months = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];



            const formattedDate = `${weekdays[now.getDay()]}, ${now.getDate()} ${months[now.getMonth()]} ${now.getFullYear()} ${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;



            dateElement.textContent = formattedDate;



        }



        function drawLossTimeMarkers(trackId, hourlyEvents, totalMinutesInTimeline) {



            const trackElement = document.getElementById(trackId);



            if (!trackElement || !hourlyEvents) return;



            trackElement.querySelectorAll('.loss-marker').forEach(marker => marker.remove());



            if (totalMinutesInTimeline <= 0) return;



            for (const hour in hourlyEvents) {



                if (hourlyEvents.hasOwnProperty(hour)) {



                    hourlyEvents[hour].forEach(event => {



                        const startOffsetMinutes = ((parseInt(hour) - 7) * 60) + event.startMinute;



                        const leftPercent = (startOffsetMinutes / totalMinutesInTimeline) * 100;



                        const widthPercent = (event.durationMinutes / totalMinutesInTimeline) * 100;



                        if (leftPercent + widthPercent <= 100) {



                            const marker = document.createElement('div');



                            marker.className = 'loss-marker';



                            marker.style.left = `${leftPercent}%`;



                            marker.style.width = `${widthPercent}%`;



                            trackElement.appendChild(marker);



                        }



                    });



                }



            }



        }



        function drawBreakTimeMarkers(trackId, breakTimes, totalMinutesInTimeline) {



            const trackElement = document.getElementById(trackId);



            if (!trackElement || !breakTimes) return;



            trackElement.querySelectorAll('.break-marker').forEach(marker => marker.remove());



            if (totalMinutesInTimeline <= 0) return;



            const timelineStartHour = 7;



            breakTimes.forEach(breakTime => {



                const startParts = breakTime.start.split(':').map(Number);



                const endParts = breakTime.end.split(':').map(Number);



                const startTotalMinutes = startParts[0] * 60 + startParts[1];



                const endTotalMinutes = endParts[0] * 60 + endParts[1];



                const startOffsetMinutes = startTotalMinutes - (timelineStartHour * 60);



                const durationMinutes = endTotalMinutes - startTotalMinutes;



                if (durationMinutes <= 0) return;



                const leftPercent = (startOffsetMinutes / totalMinutesInTimeline) * 100;



                const widthPercent = (durationMinutes / totalMinutesInTimeline) * 100;



                if (leftPercent + widthPercent <= 100) {



                    const marker = document.createElement('div');



                    marker.className = 'break-marker';



                    marker.style.left = `${leftPercent}%`;



                    marker.style.width = `${widthPercent}%`;



                    trackElement.appendChild(marker);



                }



            });



        }



        function updateAssemblyTimeline(lineId, lossData) {



            const trackElement = document.getElementById(`timeline-track-${lineId}`);



            const progressElement = document.getElementById(`timeline-progress-${lineId}`);



            const minutesContainer = document.getElementById(`timeline-minutes-${lineId}`);



            const hoursElement = document.querySelector(`#timeline-track-${lineId}`)?.closest('.timeline-container')?.querySelector('.timeline-hours') || null;



            if (!trackElement || !progressElement || !minutesContainer) return;



            const now = new Date();



            const startHour = 7;



            const endOfDayHour = 16;



            let displayEndHour = now.getHours() + 1;



            displayEndHour = Math.max(startHour + 1, displayEndHour);



            displayEndHour = Math.min(displayEndHour, endOfDayHour);



            const totalMinutesInTimeline = (displayEndHour - startHour) * 60;



            hoursElement.innerHTML = '';



            for (let h = startHour; h < displayEndHour; h++) {



                const hourSpan = document.createElement('span');



                hourSpan.textContent = `${String(h).padStart(2, '0')}.00`;



                hoursElement.appendChild(hourSpan);



            }



            minutesContainer.innerHTML = '';



            drawBreakTimeMarkers(`timeline-track-${lineId}`, lossData.breakTimes, totalMinutesInTimeline);



            drawLossTimeMarkers(`timeline-track-${lineId}`, lossData.hourlyEvents, totalMinutesInTimeline);



            const timelineStart = new Date(now);



            timelineStart.setHours(startHour, 0, 0, 0);



            let elapsedMillis = now - timelineStart;



            const totalDurationMillis = totalMinutesInTimeline * 60 * 1000;



            elapsedMillis = Math.max(0, Math.min(elapsedMillis, totalDurationMillis));



            const progressPercent = (totalDurationMillis > 0) ? (elapsedMillis / totalDurationMillis) * 100 : 0;



            progressElement.style.width = `${progressPercent}%`;



        }



        function getRowClass(oee, oratio, ability, quality) {



            const minVal = Math.min(parseFloat(oee), oratio, ability, quality);



            if (minVal < 80) return 'row-red';



            if (minVal < 85) return 'row-yellow';



            return 'row-green';



        }



                async function updateMachineEfficiency() {



            try {



                const response = await fetch('/Home/GetMachineEfficiencyFromDB');



                if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);



                const json = await response.json();



                const apiData = json.data || [];



                const tableBody = document.querySelector('.machine-efficiency-table tbody');



                tableBody.innerHTML = '';



                if (apiData.length === 0) {



                    tableBody.innerHTML = `<tr><td colspan="6" style="text-align:center;color:rgba(255,255,255,0.5);">No data available</td></tr>`;



                    return;



                }



                apiData.forEach((item, index) => {



                    const oee            = item.oEE            != null ? item.oEE.toFixed(1)            : '-';



                    const operatingRatio = item.operatingRatio  != null ? item.operatingRatio.toFixed(1)  : '-';



                    const ability        = item.ability         != null ? item.ability.toFixed(1)         : '-';



                    const quality        = item.quality         != null ? item.quality.toFixed(1)         : '-';



                    const rowClass = (oee === '-' || operatingRatio === '-')



                        ? ''



                        : getRowClass(oee, parseFloat(operatingRatio), parseFloat(ability), parseFloat(quality));



                    const row = document.createElement('tr');



                    row.className = rowClass;



                    row.innerHTML = `



                        <td>${index + 1}</td>



                        <td>${item.machineName}</td>



                        <td>${oee}</td>



                        <td>${operatingRatio}</td>



                        <td>${ability}</td>



                        <td>${quality}</td>



                    `;



                    tableBody.appendChild(row);



                });



            } catch (error) {



                console.error('[updateMachineEfficiency] Error:', error);



                const tableBody = document.querySelector('.machine-efficiency-table tbody');



                tableBody.innerHTML = `<tr><td colspan="6" style="text-align:center;color:rgba(255,255,255,0.5);">Gagal memuat data</td></tr>`;



            }



        }



                async function fetchData() {



            try {



                const response = await fetch('/Home/GetDashboardData');



                if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);



                const data = await response.json();



                // ── Update 3D Factory Floor Lines ──



                if (data.lineStatusList && window.AudioFactory3D) {



                    window.AudioFactory3D.updateLineStatuses(data.lineStatusList);



                }



                // ── Assembly Achievement ──



                const totalData = data.totalAll;



                if (totalData) {



                    const displayPlanTotal = Math.min(totalData.totalPlan, totalData.dailyPlan);



                    setTimeout(() => {



                        chartTotal = createOrUpdateChart('chartTotal', chartTotal, totalData.totalActual, displayPlanTotal, totalData.dailyPlan);



                        lastDataTotal = { actual: totalData.totalActual, plan: displayPlanTotal, maxPlan: totalData.dailyPlan };



                        document.getElementById('total-plan-display-total').textContent = totalData.dailyPlan.toLocaleString('id-ID');



                    }, 100);



                }



                // ── Pass Through Ratio ──



                const defectsByCategory = data.defectsByCategory || [];



                if (defectsByCategory.length === 0) {



                    document.getElementById('defect-bar-cu').innerHTML =



                        '<div style="color:rgba(255,255,255,0.5); text-align:center; padding:10px;">No defect data today</div>';



                } else {



                    renderDefectBar('defect-bar-cu', defectsByCategory);



                }



                const totalDefects = defectsByCategory.reduce((sum, d) => sum + d.count, 0);



                const totalActual = totalData?.totalActual || 0;



                const qualityRate = totalActual > 0 ? ((totalActual - totalDefects) / totalActual * 100) : 100;



                document.getElementById('quality-percent-cu').textContent = qualityRate.toFixed(0);



                document.getElementById('defect-count-cu').textContent = totalDefects;



                // ── Loss Time ──



                const lossTimeCU = data.lossTimeCU || {};



                document.getElementById('cu-working-time').textContent = lossTimeCU.workingTime ?? 0;



                document.getElementById('cu-loss-time').textContent = lossTimeCU.lossTime ?? 0;



                document.getElementById('cu-load-time').textContent = lossTimeCU.loadTime ?? 0;



                if (lossTimeCU && Object.keys(lossTimeCU).length > 0) {



                    updateAssemblyTimeline('cu', lossTimeCU);



                }



            } catch (error) { console.error("Could not fetch data:", error); }



        }



                        function toggleTheme() {



            const body = document.body;



            const btn = document.getElementById('theme-toggle');



            if (body.classList.contains('light-mode')) {



                body.classList.remove('light-mode');



                btn.textContent = 'Dark';



                localStorage.setItem('theme', 'dark');



            } else {



                body.classList.add('light-mode');



                btn.textContent = 'Light';



                localStorage.setItem('theme', 'light');



            }



            // Redraw KEDUA chart supaya warna jarum & angka ikut update



            createOrUpdateChart('chartTotal', null, lastDataTotal.actual, lastDataTotal.plan, lastDataTotal.maxPlan);



            if (window.AudioFactory3D) {



                window.AudioFactory3D.setTheme(body.classList.contains('light-mode') ? 'light' : 'dark');



            }



        }



        document.addEventListener('DOMContentLoaded', () => {



            setDate();



            setInterval(setDate, 1000);



            drawConnectorLines();



            if (window.AudioFactory3D) {



                window.AudioFactory3D.init('factory-3d-viewport');



            }



            fetchData();



            updateMachineEfficiency();



        setInterval(() => {



            fetchData();



            updateMachineEfficiency();



        }, 5000);



            window.addEventListener('resize', drawConnectorLines);



            const wrapperTotal = document.getElementById('chartTotal')?.closest('.chart-container');



            if (wrapperTotal) {



                new ResizeObserver(() => {



                    createOrUpdateChart('chartTotal', null, lastDataTotal.actual, lastDataTotal.plan, lastDataTotal.maxPlan);



                }).observe(wrapperTotal);



            }



            const mapCard = document.querySelector('.map-card');



            if (mapCard) {



                new ResizeObserver(() => { drawConnectorLines(); }).observe(mapCard);



            }



            const leftColumn = document.querySelector('.left-column');



            leftColumn.addEventListener('click', (event) => {



                const balloon = event.target.closest('.info-balloon');



                if (balloon && balloon.classList.contains('alert-balloon')) {



                    const isAlreadyExpanded = balloon.classList.contains('expanded');



                    document.querySelectorAll('.info-balloon.expanded').forEach(b => {



                        if (b !== balloon) b.classList.remove('expanded');



                    });



                    balloon.classList.toggle('expanded');



                    if (!isAlreadyExpanded) {



                        const details = alertDetails.get(balloon.id);



                        if (details) {



                            if (details.type === 'machine') {



                                scrollToTarget(details.targetId);



                            } else if (details.type === 'assembly' && Array.isArray(details.targets)) {



                                details.targets.forEach(targetId => highlightTarget(targetId));



                            }



                        }



                    }



                }



            });



        });



    </script>



